# Auslieferung über Apache (Webspace). Vite kopiert die Datei unverändert nach dist/.

# Kein Verzeichnislisting, keine Rückschlüsse auf den Ordnerinhalt.
Options -Indexes

# Kanonische Adresse: http:// und www. von orrery3d.de auf https://orrery3d.de umleiten.
# Nur für diesen Host; unter jensfricke.com/Orrery/ gilt dieselbe Datei ohne Umleitung.
# 302 bis zur Bestätigung im Betrieb, danach 301 (Browser speichern 301 dauerhaft).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?orrery3d\.de$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://orrery3d.de%{REQUEST_URI} [R=302,L]
</IfModule>

# KTX2-Texturen, der Basis-Transcoder und das Web-App-Manifest (Entwurf Phase 5 §5.5).
AddType image/ktx2 .ktx2
AddType application/wasm .wasm
AddType application/manifest+json .webmanifest

# Textinhalte komprimiert ausliefern; das JS-Bündel schrumpft damit auf rund ein Viertel.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/wasm
</IfModule>

<IfModule mod_headers.c>
  # Gehashte Bündel (index-XXXXXXXX.js/.css): unbegrenzt cachen, neuer Inhalt trägt einen neuen Namen.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Texturen und Musik tragen keinen Hash im Namen: einen Tag cachen, danach mit ETag nachfragen.
  <FilesMatch "\.(jpg|jpeg|png|webp|ktx2|mp3)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  # Einstieg immer nachfragen, damit ein neues Bündel sofort greift.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
