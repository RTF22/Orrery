# Vorlage für .env.local (git-ignoriert). Zugangsdaten für `npm run deploy`.
# FTP-Zugang aus der KAS-Verwaltung; DEPLOY_DIR ist der Pfad ab dem FTP-Stammverzeichnis
# bis in den Unterordner der Domain, in dem die Seite liegen soll.
DEPLOY_HOST=ftp.example.org
DEPLOY_USER=w0123456
DEPLOY_PASSWORD=
DEPLOY_DIR=/example.org/Orrery
# Port, falls nicht 21.
# DEPLOY_PORT=21
# FTPS (explizites TLS) ist Standard; nur zum Abschalten auf false setzen.
# DEPLOY_SECURE=false
